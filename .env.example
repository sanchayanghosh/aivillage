# Hugging Face token with access to the gated dataset aidigestorg/ai-village.
# Accept the dataset terms on huggingface.co first, then create a read token.
HF_TOKEN=

# Studio agent and report writer (libfx). Optional: without a key the studio
# falls back to an offline, rule-based verbose report.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Step 2 hypothesis model. gemini | ollama | (unset = offline deterministic)
# FORENSICS_MODEL=gemini
# GEMINI_API_KEY=
