{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals", "node"],
    "jsx": "react-jsx",
    "outDir": "dist"
  },
  "include": ["src", "tests", "vite.config.ts"]
}
